import React, { useState, useEffect, useRef } from "react";
import { 
  Play, Pause, Camera, Sparkles, Sliders, Film, Users, Share2, 
  Download, Clock, CheckCircle, Video, MessageSquare, ArrowRight, RefreshCw 
} from "lucide-react";

export default function LuminaWebStudio() {
  const [activeTab, setActiveTab] = useState<"studio" | "editor" | "script" | "team" | "publish">("studio");
  const [isPlaying, setIsPlaying] = useState(true);
  const [playhead, setPlayhead] = useState(0);
  const [prompt, setPrompt] = useState("A cybernetic creator walking through neon-drenched neo-Tokyo street with anamorphic lens flares");
  const [cameraMotion, setCameraMotion] = useState("FPV Drone Sweep");
  const [style, setStyle] = useState("Cyberpunk 2099");
  const [filter, setFilter] = useState("Cyber Neon");
  const [isCameraActive, setIsCameraActive] = useState(false);
  const videoRef = useRef<HTMLVideoElement>(null);

  // Playhead loop timer
  useEffect(() => {
    let interval: any;
    if (isPlaying && !isCameraActive) {
      interval = setInterval(() => {
        setPlayhead(prev => (prev >= 5 ? 0 : Number((prev + 0.1).toFixed(1))));
      }, 100);
    }
    return () => clearInterval(interval);
  }, [isPlaying, isCameraActive]);

  // Webcam stream handler
  useEffect(() => {
    if (isCameraActive) {
      navigator.mediaDevices?.getUserMedia({ video: true })
        .then(stream => {
          if (videoRef.current) videoRef.current.srcObject = stream;
        })
        .catch(err => console.error("Camera access error:", err));
    } else {
      if (videoRef.current && videoRef.current.srcObject) {
        const stream = videoRef.current.srcObject as MediaStream;
        stream.getTracks().forEach(track => track.stop());
      }
    }
  }, [isCameraActive]);

  return (
    <div className="min-h-screen bg-[#090C15] text-slate-100 font-sans flex flex-col">
      {/* Top Studio Header */}
      <header className="border-b border-slate-800 bg-[#111726] px-6 py-3 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="h-9 w-9 rounded-lg bg-indigo-600/30 border border-cyan-400 flex items-center justify-center font-black text-cyan-400">
            LM
          </div>
          <div>
            <h1 className="text-lg font-black tracking-wide flex items-center gap-2">
              LUMINA <span className="text-cyan-400">MOTION</span>
              <span className="text-[10px] bg-indigo-600/30 border border-indigo-500 text-indigo-300 px-1.5 py-0.5 rounded font-bold">
                STUDIO WEB
              </span>
            </h1>
            <p className="text-xs text-slate-400 flex items-center gap-1.5">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse" />
              Cybernetic Horizon • 1080p 60 FPS
            </p>
          </div>
        </div>

        <div className="flex items-center gap-3">
          <button 
            onClick={() => setIsCameraActive(!isCameraActive)}
            className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 border transition ${
              isCameraActive 
                ? "bg-red-500/20 border-red-500 text-red-300" 
                : "bg-slate-800 border-slate-700 text-cyan-400 hover:bg-slate-700"
            }`}
          >
            <Camera className="h-3.5 w-3.5" />
            {isCameraActive ? "EXIT CAMERA" : "SOURCE WEBCAM"}
          </button>
          <button 
            onClick={() => setActiveTab("publish")}
            className="px-4 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white flex items-center gap-1.5"
          >
            <Download className="h-3.5 w-3.5" /> EXPORT HD
          </button>
        </div>
      </header>

      {/* Main Studio Workspace */}
      <main className="flex-1 max-w-6xl mx-auto w-full p-4 grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left Column: Live Canvas & Viewport */}
        <div className="lg:col-span-5 flex flex-col items-center">
          <div className="relative w-full max-w-[340px] aspect-[9/16] bg-[#0c101c] rounded-2xl border border-slate-800 shadow-2xl overflow-hidden flex items-center justify-center">
            {isCameraActive ? (
              <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-cover" />
            ) : (
              <div className="relative w-full h-full overflow-hidden">
                {/* Real Person Creator Footage with Parallax Motion */}
                <img 
                  src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80" 
                  alt="Real Person Creator"
                  className="w-full h-full object-cover transition-transform duration-700 scale-105"
                  style={{
                    filter: filter === "Cyber Neon" ? "hue-rotate(180deg) contrast(1.2)" : 
                            filter === "Chromatic Glitch" ? "contrast(1.4) saturate(1.5)" : "none"
                  }}
                />
                {/* Neon Street HUD Overlay */}
                <div className="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/40 pointer-events-none" />
              </div>
            )}

            {/* Top Badges */}
            <div className="absolute top-3 inset-x-3 flex justify-between items-center text-[10px] font-bold">
              <span className="bg-black/60 backdrop-blur px-2 py-1 rounded text-emerald-400 border border-slate-700 flex items-center gap-1">
                <span className="h-1.5 w-1.5 rounded-full bg-emerald-400" /> 1080P • 60 FPS
              </span>
              <span className="bg-black/60 backdrop-blur px-2 py-1 rounded text-cyan-400 border border-slate-700">
                {cameraMotion.toUpperCase()}
              </span>
            </div>

            {/* Bottom Transport Controls */}
            <div className="absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-black/90 to-transparent">
              {/* Progress bar */}
              <div className="w-full h-1 bg-white/20 rounded-full mb-2 overflow-hidden">
                <div 
                  className="h-full bg-gradient-to-r from-indigo-500 to-cyan-400"
                  style={{ width: `${(playhead / 5) * 100}%` }}
                />
              </div>

              <div className="flex items-center justify-between text-xs">
                <div className="flex items-center gap-2">
                  <button 
                    onClick={() => setIsPlaying(!isPlaying)}
                    className="h-7 w-7 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white"
                  >
                    {isPlaying ? <Pause className="h-3.5 w-3.5" /> : <Play className="h-3.5 w-3.5" />}
                  </button>
                  <span className="font-mono text-slate-300 text-[11px]">
                    00:0{playhead.toFixed(1)} / 00:05.0
                  </span>
                </div>
                <span className="text-[10px] text-pink-400 font-bold bg-pink-500/10 px-1.5 py-0.5 rounded">
                  FX: {filter}
                </span>
              </div>
            </div>
          </div>
        </div>

        {/* Right Column: Studio Controls Deck */}
        <div className="lg:col-span-7 flex flex-col bg-[#111726] rounded-2xl border border-slate-800 p-5">
          {/* Studio Tab Switcher */}
          <div className="flex border-b border-slate-800 pb-3 gap-2 overflow-x-auto">
            {[
              { id: "studio", label: "Studio Prompt", icon: Film },
              { id: "editor", label: "Timeline & VFX", icon: Sliders },
              { id: "script", label: "Script AI", icon: Sparkles },
              { id: "team", label: "Team & Version", icon: Users },
              { id: "publish", label: "Social Scheduler", icon: Share2 }
            ].map(tab => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id as any)}
                className={`px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition ${
                  activeTab === tab.id 
                    ? "bg-indigo-600 text-white" 
                    : "text-slate-400 hover:text-white hover:bg-slate-800"
                }`}
              >
                <tab.icon className="h-3.5 w-3.5" />
                {tab.label}
              </button>
            ))}
          </div>

          {/* Tab 1: Studio Prompt */}
          {activeTab === "studio" && (
            <div className="mt-4 flex flex-col gap-4">
              <div>
                <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">
                  Natural Language Prompt (Higgsfield Veo Engine)
                </label>
                <textarea
                  value={prompt}
                  onChange={e => setPrompt(e.target.value)}
                  rows={3}
                  className="w-full mt-1.5 bg-[#0a0d17] border border-slate-700 rounded-xl p-3 text-sm text-slate-100 focus:outline-none focus:border-cyan-400"
                />
              </div>

              <div>
                <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">
                  Camera Motion Trajectory
                </label>
                <div className="grid grid-cols-3 gap-2 mt-1.5">
                  {["FPV Drone Sweep", "360° Orbit", "Dynamic Zoom", "Crane Pedestal", "Bullet Time", "Tripod"].map(m => (
                    <button
                      key={m}
                      onClick={() => setCameraMotion(m)}
                      className={`p-2 rounded-lg text-xs font-medium border text-left transition ${
                        cameraMotion === m 
                          ? "bg-indigo-950 border-cyan-400 text-cyan-300" 
                          : "bg-slate-900 border-slate-800 text-slate-400"
                      }`}
                    >
                      {m}
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">
                  Visual Aesthetic & Style
                </label>
                <div className="grid grid-cols-3 gap-2 mt-1.5">
                  {["Cyberpunk 2099", "Photorealistic 8K", "Cinematic 35mm", "Anime Studio", "Retro Synth", "Claymation"].map(s => (
                    <button
                      key={s}
                      onClick={() => setStyle(s)}
                      className={`p-2 rounded-lg text-xs font-medium border text-left transition ${
                        style === s 
                          ? "bg-indigo-950 border-indigo-400 text-indigo-300" 
                          : "bg-slate-900 border-slate-800 text-slate-400"
                      }`}
                    >
                      {s}
                    </button>
                  ))}
                </div>
              </div>

              <button className="mt-2 w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-500 font-bold text-sm text-white shadow-lg hover:opacity-95 flex items-center justify-center gap-2">
                <Sparkles className="h-4 w-4" /> GENERATE AI VIDEO
              </button>
            </div>
          )}

          {/* Tab 2: Timeline & VFX */}
          {activeTab === "editor" && (
            <div className="mt-4 flex flex-col gap-4">
              <div className="p-3 bg-slate-900 rounded-xl border border-slate-800">
                <div className="flex justify-between items-center text-xs mb-2">
                  <span className="font-bold text-slate-400">TIMELINE REEL (2 CLIPS)</span>
                  <span className="text-cyan-400 font-mono">Total: 10.0s</span>
                </div>
                <div className="flex gap-2">
                  <div className="flex-1 p-2 bg-indigo-950 border border-cyan-400 rounded-lg text-xs">
                    <p className="font-bold text-cyan-300">Clip #1 (Cybernetic)</p>
                    <p className="text-[10px] text-slate-400">00:00 - 00:05</p>
                  </div>
                  <div className="flex-1 p-2 bg-slate-800 border border-slate-700 rounded-lg text-xs">
                    <p className="font-bold text-slate-300">Clip #2 (Orbital)</p>
                    <p className="text-[10px] text-slate-400">00:05 - 00:10</p>
                  </div>
                </div>
              </div>

              <div>
                <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">
                  Real-Time VFX Filter Shaders
                </label>
                <div className="grid grid-cols-4 gap-2 mt-1.5">
                  {["Cyber Neon", "Chromatic Glitch", "90s VHS", "35mm Grain", "Golden Hour", "Duotone", "Emerald Matrix", "Raw"].map(f => (
                    <button
                      key={f}
                      onClick={() => setFilter(f)}
                      className={`p-2 rounded-lg text-xs font-medium border text-center transition ${
                        filter === f ? "bg-pink-950 border-pink-500 text-pink-300" : "bg-slate-900 border-slate-800 text-slate-400"
                      }`}
                    >
                      {f}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* Tab 5: Social Scheduler & Export */}
          {activeTab === "publish" && (
            <div className="mt-4 flex flex-col gap-4">
              <div className="grid grid-cols-2 gap-3">
                <button className="p-3 bg-indigo-600 hover:bg-indigo-500 rounded-xl text-left font-bold text-xs">
                  <Download className="h-4 w-4 mb-1" />
                  DOWNLOAD 1080P MP4
                  <p className="text-[10px] font-normal text-indigo-200">Zero watermark • Master encode</p>
                </button>
                <button className="p-3 bg-slate-800 hover:bg-slate-700 rounded-xl text-left font-bold text-xs">
                  <Film className="h-4 w-4 mb-1" />
                  4K PRORES MASTER
                  <p className="text-[10px] font-normal text-slate-400">Cinematic ProRes 422 HQ</p>
                </button>
              </div>

              <div className="p-3 bg-slate-900 rounded-xl border border-slate-800 flex flex-col gap-2">
                <span className="text-xs font-bold text-slate-300">SCHEDULE TO SOCIAL CHANNELS</span>
                <div className="flex gap-2">
                  {["TikTok", "Instagram Reels", "YouTube Shorts", "X"].map(p => (
                    <button key={p} className="flex-1 py-1.5 bg-slate-800 hover:bg-slate-700 text-xs font-bold rounded-lg">
                      {p}
                    </button>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      </main>
    </div>
  );
}
